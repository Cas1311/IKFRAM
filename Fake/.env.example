# Application
VITE_APP_NAME="MoneyMate"
VITE_APP_DESCRIPTION="Persoonlijk financieel beheer"
VITE_APP_VERSION=1.0.0
VITE_APP_API_BASE_URL=/api

# Environment (development, production, test)
NODE_ENV=development
VITE_NODE_ENV=development

# Firebase Configuration (optional)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_PUSH_NOTIFICATIONS=false

# Internationalization
VITE_DEFAULT_LOCALE=nl-NL
VITE_FALLBACK_LOCALE=en-US
VITE_SUPPORTED_LOCALES=nl-NL,en-US

# Build Settings
VITE_SOURCEMAP=true
VITE_DROP_CONSOLE=false
VITE_DROP_DEBUGGER=false

# PWA Configuration (if using Vite PWA plugin)
VITE_PWA_ENABLED=true
VITE_PWA_REGISTER_TYPE=autoUpdate
VITE_PWA_USE_HASH=false

# API Endpoints (if applicable)
# VITE_API_URL=https://api.example.com
# VITE_WS_URL=wss://ws.example.com

# Development Server
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=3000
VITE_DEV_SERVER_HTTPS=false

# Testing
VITE_TEST_ENV=unit

# Note: Add this file to .gitignore and create a .env file with your actual values
